# systemd unit for the Oracle VM — API only (frontend lives on Vercel,
# database on Neon, so no local postgres dependency). Install per
# deploy/ORACLE.md. Secrets are read by the app itself from server/.env
# (chmod 600); nothing sensitive lives in this file.
[Unit]
Description=BSBW CRM API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/bsbw-crm/server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
