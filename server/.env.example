# ---------------------------------------------------------------------------
# Copy this file to server/.env and fill it in. .env is gitignored.
# ---------------------------------------------------------------------------

# Postgres. Create the database first:
#   psql -U postgres -c "CREATE DATABASE bsbw_crm;"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bsbw_crm

PORT=4000

# Where the frontend runs. Used for CORS. In dev, Vite proxies /api to port
# 4000 so the browser stays on one origin and this rarely comes into play; it
# matters once the built bundle is served from somewhere else.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Administrator
#
# There are no user accounts. Anyone who can reach the app opens either
# organization and works its pipeline. One action is held back, because it
# changes what the whole installation contains rather than what is inside one
# tenant: creating an organization (and deleting one). Both ask for these.
#
# They are checked against the request that needs them and nothing is
# remembered afterwards - no session, no cookie. Change them before this runs
# anywhere other people can reach; the server prints a warning at boot while
# it is still on the shipped defaults.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@bsbw.co
ADMIN_PASSWORD=changeme-please

# Fallback signature, used only by an organization that hasn't set its own —
# each one carries its own sender name and address, editable from Organization
# settings. Outbound mail is sent by you from Gmail, not by this app, so this
# is a label only: it does not control what address anything leaves from.
SENDER_NAME=Partnerships
SENDER_EMAIL=

# ---------------------------------------------------------------------------
# Reply detection — read-only IMAP
#
# The server watches this mailbox and files each reply against the company
# whose contact address matches the sender, moving it to Responded. It only
# ever reads: nothing is sent, moved, deleted or marked as read.
#
# One mailbox serves every organization. A reply is filed against whichever
# tenant has the sender on file, so each one only ever sees its own — but they
# share these credentials, and a contact address listed by two organizations
# is filed to the lower company id. Give each tenant its own mailbox by running
# a second instance against a second database.
#
# For Gmail, about three minutes:
#   1. Turn on 2-step verification:  myaccount.google.com/security
#   2. Create an app password:       myaccount.google.com/apppasswords
#      (16 characters shown in four groups - paste it with or without spaces)
#   3. Put your address and that password below, then restart the API.
#
# Use an app password, NOT your Google account password - Google blocks plain
# password logins over IMAP.
#
# Leave these blank and everything else still works: "Log a reply" records
# replies by hand.
# ---------------------------------------------------------------------------
IMAP_USER=
IMAP_PASSWORD=

# Defaults suit Gmail. Change for another provider:
#   Outlook/365   outlook.office365.com : 993
#   Yahoo         imap.mail.yahoo.com   : 993
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
IMAP_TIMEOUT_MS=60000

# How often the server checks, in ms. 0 turns the background poller off and
# leaves only the "Check now" button.
MAIL_POLL_MS=90000
# How far back to look. Also how long after a reply arrives it can still be
# found if the server was down when it came in.
MAIL_LOOKBACK_DAYS=30
# Ceiling on message bodies downloaded per run, newest first. Stops a first
# sync against a busy mailbox from running for minutes.
MAIL_MAX_FETCH=60

# ---------------------------------------------------------------------------
# Inbound webhook (optional, and unnecessary if IMAP is on)
# For routing mail through a provider's inbound parse instead. Set a secret or
# anyone who finds POST /api/emails/inbound can write into your pipeline.
# ---------------------------------------------------------------------------
INBOUND_SECRET=
